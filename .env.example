# Copy this file to .env and fill in real values. Never commit .env itself
# (see .gitignore) -- and note that adding it to .gitignore after the fact
# does not remove it from git history if it was ever committed (§10.10).

# Your everyday development database. PostgreSQL only (NUMERIC support matters
# for §8.3 -- see docs/SPEC.md).
DATABASE_URL=postgresql://user:password@localhost:5432/expense_splitting

# A SEPARATE database, used only by the test suite. Its name must contain
# "test" -- tests/conftest.py refuses to run otherwise, as the only thing
# standing between a typo here and truncating the dev database (§10.7).
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/expense_splitting_test

# Secret key used to sign JWTs. Generate a real one locally, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never reuse the CI/example value below outside of CI.
JWT_SECRET=change-me-to-a-long-random-value

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated browser origins allowed to call the API cross-origin. Leave
# empty for local dev (the Vite dev server proxies /api, so requests are
# same-origin). In production set it to the deployed frontend URL, e.g.:
#   CORS_ALLOW_ORIGINS=https://your-app.vercel.app
# Use exact origins (scheme + host, no trailing slash, no path); never "*".
CORS_ALLOW_ORIGINS=
