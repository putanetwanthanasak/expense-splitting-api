# Base URL the frontend prepends to every API path.
# Leave empty for local dev — `npm run dev` proxies /api -> the FastAPI backend
# (see vite.config.ts). Set it for deployments where the API is on another origin.
VITE_API_BASE_URL=

# Optional: override the dev proxy target (default http://localhost:8000).
# VITE_DEV_API_PROXY=http://localhost:8000
