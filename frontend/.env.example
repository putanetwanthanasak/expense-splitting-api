# Frontend build-time configuration (Vite). Copy to `.env` for local overrides;
# `.env` is gitignored. Only variables prefixed VITE_ are exposed to the app.

# Origin of the backend API — scheme + host only, NO trailing slash, NO "/api"
# suffix (the app appends "/api/..." itself; see src/lib/api.ts).
#
# Local dev: leave this UNSET. The Vite dev server proxies "/api" to
# http://localhost:8000 (vite.config.ts), so the app uses same-origin
# relative URLs and no CORS is involved.
#
# Production (Vercel): set it to the deployed backend URL, e.g.
#   VITE_API_BASE_URL=https://expense-splitting-api.onrender.com
VITE_API_BASE_URL=

# Optional: point the dev-server proxy somewhere other than
# http://localhost:8000. Only affects `npm run dev`.
# VITE_DEV_API_PROXY=http://localhost:8000
